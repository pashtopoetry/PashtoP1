<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/card_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top row: Poet name and media type indicator -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp">

            <!-- Type badge (Text, Photo, Video) -->
            <TextView
                android:id="@+id/tvAdminPostType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="#E2E8F0"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:textColor="#334155"
                android:textSize="10sp"
                android:textStyle="bold"
                android:text="غزل" />

            <!-- Poet name -->
            <TextView
                android:id="@+id/tvAdminPostPoet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:textColor="@color/text_light"
                android:textSize="14sp"
                android:textStyle="bold"
                android:text="حمزه بابا" />
        </RelativeLayout>

        <!-- Poetry Text Snippet -->
        <TextView
            android:id="@+id/tvAdminPostText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:gravity="end"
            android:textDirection="rtl"
            android:fontFamily="serif"
            android:textColor="@color/text_light"
            android:textSize="14sp"
            android:maxLines="4"
            android:ellipsize="end" />

        <!-- Divider line -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#F1F5F9"
            android:layout_marginBottom="10dp" />

        <!-- Bottom row: Date and Delete Button -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Delete Button on the left -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAdminDelete"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:text="@string/delete"
                android:textSize="12sp"
                android:textColor="@color/red_delete"
                app:backgroundTint="#FEE2E2"
                app:cornerRadius="8dp" />

            <!-- Published Date on the right -->
            <TextView
                android:id="@+id/tvAdminPostDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:textColor="@color/gray_text"
                android:textSize="10sp"
                android:text="نږدې ۱ بجه" />
        </RelativeLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
