<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="@color/card_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header: Poet Avatar, Name, Category and Views -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <!-- Left side: Category & Views -->
            <LinearLayout
                android:id="@+id/layoutLeftMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:orientation="vertical"
                android:gravity="start">

                <TextView
                    android:id="@+id/tvCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#E0F2FE"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:textColor="#0369A1"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:text="غزل" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp"
                    android:background="#F1F5F9"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp">

                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginEnd="4dp"
                        android:src="@drawable/ic_eye"
                        app:tint="#64748B" />

                    <TextView
                        android:id="@+id/tvViews"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#64748B"
                        android:textSize="9sp"
                        android:text="1.2K" />
                </LinearLayout>
            </LinearLayout>

            <!-- Right side: Profile and Name -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="end"
                    android:layout_marginEnd="10dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/ivVerifiedBadge"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_marginEnd="4dp"
                            android:src="@drawable/ic_verified"
                            android:visibility="visible" />

                        <TextView
                            android:id="@+id/tvPoet"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_light"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:text="حمزه بابا" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#94A3B8"
                        android:textSize="9sp"
                        android:text="همدا اوس" />
                </LinearLayout>

                <!-- Poet Avatar Frame with ShapeableImageView -->
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivPoetAvatar"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/CircleImage"
                    android:src="@drawable/ic_launcher"
                    app:strokeColor="@color/primary"
                    app:strokeWidth="1.5dp" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#F1F5F9"
            android:layout_marginBottom="12dp" />

        <!-- Poetry Text Block (RTL, Serif, Green Right Border) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tvPoetryText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:textDirection="rtl"
                android:fontFamily="serif"
                android:lineSpacingMultiplier="1.3"
                android:textColor="@color/text_light"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Vertical accent green line on the right for RTL support -->
            <View
                android:layout_width="3.5dp"
                android:layout_height="match_parent"
                android:layout_marginStart="12dp"
                android:background="@color/primary" />
        </LinearLayout>

        <!-- Image attachment -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivAttachment"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginBottom="12dp"
            android:scaleType="centerCrop"
            android:visibility="gone"
            app:shapeAppearanceOverlay="@style/CircleImage"
            app:cornerSize="12dp" />

        <!-- Video Player Attachment -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardVideoPlayer"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginBottom="12dp"
            android:visibility="gone"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#000000">

            <androidx.media3.ui.PlayerView
                android:id="@+id/playerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:use_controller="true" />
        </androidx.cardview.widget.CardView>

        <!-- Divider before footer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#F1F5F9"
            android:layout_marginBottom="10dp" />

        <!-- Footer Actions Bar with ScrollView to prevent overflow on narrow screens -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="2dp">

                <!-- Like Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLike"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:paddingHorizontal="10dp"
                    android:text="18"
                    android:textSize="11sp"
                    android:textColor="#FF1744"
                    app:icon="@drawable/ic_heart"
                    app:iconTint="#FF1744"
                    app:iconSize="14dp"
                    app:iconGravity="textStart"
                    app:cornerRadius="10dp" />

                <!-- Favorite Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFavorite"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:paddingHorizontal="10dp"
                    android:text="خوندي"
                    android:textSize="11sp"
                    android:textColor="#D97706"
                    app:icon="@drawable/ic_bookmark"
                    app:iconTint="#D97706"
                    app:iconSize="14dp"
                    app:iconGravity="textStart"
                    app:cornerRadius="10dp" />

                <!-- WhatsApp Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnWhatsApp"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:paddingHorizontal="10dp"
                    android:text="واټساپ"
                    android:textSize="11sp"
                    android:textColor="#16A34A"
                    app:icon="@drawable/ic_whatsapp"
                    app:iconTint="#16A34A"
                    app:iconSize="14dp"
                    app:iconGravity="textStart"
                    app:cornerRadius="10dp" />

                <!-- Copy Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCopy"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="4dp"
                    android:paddingHorizontal="8dp"
                    android:text="کاپي"
                    android:textSize="11sp"
                    android:textColor="#475569"
                    app:icon="@drawable/ic_copy"
                    app:iconTint="#475569"
                    app:iconSize="14dp"
                    app:iconGravity="textStart" />

                <!-- Share Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnShare"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:paddingHorizontal="8dp"
                    android:text="شریک"
                    android:textSize="11sp"
                    android:textColor="#475569"
                    app:icon="@drawable/ic_share"
                    app:iconTint="#475569"
                    app:iconSize="14dp"
                    app:iconGravity="textStart" />

            </LinearLayout>
        </HorizontalScrollView>

    </LinearLayout>
</androidx.cardview.widget.CardView>
